{
  "name": "@peribolos/demo-seller",
  "version": "0.1.0",
  "private": true,
  "description": "x402-protected demo seller API for Peribolos — the payment counterparty a Peribolos-governed agent pays via Circle Gateway Nanopayments (gasless x402) on Arc testnet.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx --env-file=.env src/server.ts",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "express": "^4.21.2",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
