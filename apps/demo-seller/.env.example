# Peribolos demo-seller — public seller address only (no private key).
SELLER_ADDRESS=0x...
PORT=3402
# Exact comma-separated browser origins. Do not use * in a public deployment.
CORS_ORIGINS=http://localhost:3000
# Per-IP requests per minute; place a shared rate limiter in front of multi-instance deployments.
RATE_LIMIT_MAX=60
# Arc testnet CAIP-2 (default)
# GATEWAY_NETWORK=eip155:5042002
# Circle Gateway testnet facilitator (required for Arc testnet; SDK default is mainnet)
# GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
