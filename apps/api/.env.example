# Peribolos V2 API Server Configuration - Copy to .env

# Server HTTP Port (default: 3400)
PORT=3400

# Environment mode (development / production / test)
NODE_ENV=development

# Arc Network RPC Endpoint
ARC_RPC_URL=https://rpc.testnet.arc.network

# Master secret key used to encrypt agent private keys (32+ bytes recommended)
SIGNER_ENCRYPTION_KEY=peribolos-v2-dev-signer-master-secret-key-32b!

# Set to 1 to disable background event indexing worker
PERIBOLOS_DISABLE_INDEXER=0
