# Peribolos V2 API Server Configuration - Copy to .env

# Server HTTP Port (default: 3400)
PORT=3400

# Environment mode (development / production / test)
NODE_ENV=development

# Arc Network RPC Endpoint
ARC_RPC_URL=https://rpc.testnet.arc.network

# Master secret key used to encrypt managed signer keys (required outside tests)
SIGNER_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# Local-only database file path. Production uses the Supabase state table.
PERIBOLOS_DB_FILE=./data/db.json

# Browser/API and hosted auth configuration
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Circle Developer-Controlled Wallets (required for hosted signer provisioning)
CIRCLE_API_KEY=
ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# Set to 1 to disable background event indexing worker
PERIBOLOS_DISABLE_INDEXER=0
