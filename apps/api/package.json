{
  "name": "@peribolos/api",
  "version": "0.1.0",
  "description": "Peribolos V2 Backend API - Managed Signer, Hosted Payments, Event Indexer, & Audit Engine for AI Agent Spending Controls on Arc",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit test/api.test.ts"
  },
  "dependencies": {
    "@peribolos/core": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
