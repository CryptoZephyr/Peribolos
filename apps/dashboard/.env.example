# Peribolos dashboard - client-side configuration. Copy to .env.local.

# Peribolos backend API URL (defaults to http://localhost:3400 if unset)
# NEXT_PUBLIC_API_URL=http://localhost:3400

# Strongly recommended for demos: managed Arc testnet RPC.
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network

# Passkey owner sign-in (Circle Modular Wallets) — OPTIONAL / not required for demo.
# NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# Never put a private key in a NEXT_PUBLIC_* variable. The public dashboard is read-only.
