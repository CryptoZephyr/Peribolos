{
  "name": "@peribolos/demo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Peribolos demo agent — proves the injection block live: a scripted (no-LLM, rehearsal-safe) run and a real LLM agent run, both against a live vault on Arc testnet.",
  "type": "module",
  "scripts": {
    "demo": "tsx --env-file=.env src/scripted-demo.ts",
