# Peribolos demo-agent — copy to .env and fill in.
# The agent key is a low-trust, vault-scoped key. Never commit .env.

# Agent EOA private key for the demo domain (vault-scoped: can only propose payments)
AGENT_PRIVATE_KEY=0x...

# The demo domain's vault address (from the dashboard / createDomain)
VAULT_ADDRESS=0x...

# An address on the vault's allowlist, for the legitimate-payment beat (scripted demo)
ALLOWLISTED_PAYEE=0x...

# --- optional ---
# x402 seller endpoint the agent buys from (default: local demo-seller weather route)
SELLER_URL=http://localhost:3402/weather/lagos
# Set to false to skip the petty-cash beat if you have not deposited into Gateway yet
RUN_PETTY_CASH=true
# Override Arc testnet RPC (default: public endpoint)
# RPC_URL=https://arc-testnet.g.alchemy.com/v2/YOUR_KEY

# --- LLM demo only (npm run demo:llm) ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-5

# --- LLM demo (npm run demo:llm) — free models via OpenRouter ---
OPENROUTER_API_KEY=sk-or-...
# MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
